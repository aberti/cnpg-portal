package templates

import (
	"fmt"

	"github.com/aberti/cnpg-portal/internal/tenant"
)

// TenantList renders the / route: every database in the CNPG cluster with
// owner, size, live connection count, the last cluster-wide CNPG backup
// timestamp, and a per-row Actions column.
//

// Branch and Drop mutate cluster.yaml + SOPS files in the workspace
// workspace, which the in-cluster pod cannot do without bypassing GitOps —

templ TenantList(tenants []tenant.Tenant, login string, isAdmin bool) {
	@Layout("cnpg-portal — tenants") {
		<div class="page-heading">
			<div>
				<p class="eyebrow">{ CurrentPage(ctx).Namespace } / { CurrentPage(ctx).ClusterName }</p>
				<h1>{ CurrentPage(ctx).DisplayName }</h1>
				<p class="muted">Tenant databases managed by CloudNativePG.</p>
			</div>
			<div class="toolbar">
				if isAdmin {
					<a href={ Route(ctx, "/new") } class="button">Create tenant</a>
				}
				@BackupStatus(true, nil, "", isAdmin)
			</div>
		</div>
		<dl class="cluster-summary">
			<div class="metric">
				<dt>Tenants</dt>
				<dd>{ fmt.Sprintf("%d", len(tenants)) }</dd>
			</div>
			<div class="metric">
				<dt>CNPG cluster</dt>
				<dd><code>{ CurrentPage(ctx).ClusterName }</code></dd>
			</div>
			<div class="metric">
				<dt>Namespace</dt>
				<dd><code>{ CurrentPage(ctx).Namespace }</code></dd>
			</div>
			<div class="metric">
				<dt>Last backup</dt>
				<dd>{ lastBackup(tenants) }</dd>
			</div>
		</dl>
		if len(tenants) == 0 {
			<article><p>No tenants found in this cluster.</p></article>
		} else {
			<section class="table-card" aria-labelledby="tenant-table-title">
				<div class="table-tools">
					<div>
						<h2 id="tenant-table-title">Tenant inventory</h2>
						<small class="muted">Select a database to inspect activity and credentials.</small>
					</div>
					<input type="search" data-tenant-filter placeholder="Filter by database or owner…" aria-label="Filter tenants"/>
				</div>
				<div class="table-scroll">
					<table>
						<thead>
							<tr>
								<th scope="col">Database</th>
								<th scope="col" class="hide-mobile">Owner</th>
								<th scope="col">Size</th>
								<th scope="col">Connections</th>
								<th scope="col">Actions</th>
							</tr>
						</thead>
						<tbody>
							for i := range tenants {
								@tenantRow(&tenants[i], isAdmin)
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	}
}

templ tenantRow(t *tenant.Tenant, isAdmin bool) {
	<tr data-tenant-row>
		<td>
			<a class="database-name" href={ Route(ctx, "/tenant/" + t.Name) }>{ t.Name }</a>
		</td>
		<td class="hide-mobile">{ t.Owner }</td>
		<td>{ tenant.FormatBytes(t.SizeBytes) }</td>
		<td>{ fmt.Sprintf("%d", t.Connections) }</td>
		<td>
			if isAdmin {
				<a
					href={ Route(ctx, "/tenant/" + t.Name + "/dump") }
					class="button secondary small"
					title={ "Stream pg_dump -Fc for " + t.Name + " as a custom-format dump file" }
				>Download</a>
			} else {
				<small class="muted">—</small>
			}
		</td>
	</tr>
}

func lastBackup(tenants []tenant.Tenant) string {
	for i := range tenants {
		if tenants[i].LastBackup != "" {
			return tenants[i].LastBackup
		}
	}
	return "No completed backup"
}
