package templates

import (
	"fmt"

	"github.com/aberti/cnpg-portal/internal/connstr"
	"github.com/aberti/cnpg-portal/internal/tenant"
)

// TenantDetail renders the focused per-tenant view at /tenant/<app>:
// size + connections + role attributes + last cluster-wide CNPG backup
// + the per-format Connection strings panel (creds may be nil when the
// in-cluster Secret is missing or RBAC is too narrow — the panel
// degrades to a notice in that case).
templ TenantDetail(t *tenant.Tenant, creds *tenant.Credentials, isAdmin bool) {
	@Layout("cnpg-portal — " + t.Name) {
		<nav aria-label="breadcrumb">
			<ul>
				<li><a href={ Route(ctx, "/") }>Tenants</a></li>
				<li aria-current="page">{ t.Name }</li>
			</ul>
		</nav>
		<div class="page-heading">
			<div>
				<p class="eyebrow">{ CurrentPage(ctx).DisplayName }</p>
				<h1>{ t.Name }</h1>
				if hasManagedRole(t) {
					<span class="badge">Managed tenant</span>
				} else {
					<span class="badge viewer">Externally managed database</span>
				}
			</div>
		</div>
		<div class="cards">
			<article>
				<header><h2>Database</h2></header>
				<dl class="kv">
					@kv("Name", t.Database)
					@kv("Owner role", t.Owner)
					@kv("Size", tenant.FormatBytes(t.SizeBytes))
					@kv("Connections", fmt.Sprintf("%d", t.Connections))
					if t.LastBackup != "" {
						@kv("Last cluster backup", t.LastBackup)
					} else {
						@kv("Last cluster backup", "—")
					}
				</dl>
			</article>
			<article>
				<header><h2>Role attributes</h2></header>
				<dl class="kv">
					@kv("Login", boolStr(t.Login))
					@kv("Create DB", boolStr(t.CreateDB))
					@kv("Inherit", boolStr(t.Inherit))
					@kv("Connection limit", connLimitStr(t.ConnectionLimit))
					if hasManagedRole(t) {
						@kv("Secret", t.SecretName)
					} else {
						@kv("Credentials", "Managed externally for owner role "+t.Owner)
					}
				</dl>
			</article>
		</div>
		if isAdmin {
			if hasManagedRole(t) {
				@connectionStrings(creds)
			} else {
				<article>
					<header><h2>Connection credentials</h2></header>
					<p class="muted">This database uses the shared owner role <code>{ t.Owner }</code>. CNPG Portal does not display or rotate credentials managed by the external application.</p>
				</article>
			}
			<article>
				<header><h2>Live activity</h2></header>
				<p><a href={ Route(ctx, "/tenant/" + t.Name + "/conns") }>View active connections</a></p>
			</article>
		}
		if isAdmin {
			<article>
				<header><h2>Operations</h2></header>
				<div class="toolbar" style="justify-content:flex-start;">
					<a href={ Route(ctx, "/tenant/" + t.Name + "/branch") } class="button">Branch</a>
					if hasManagedRole(t) {
						<a href={ Route(ctx, "/tenant/" + t.Name + "/sync") } class="button secondary">Sync from…</a>
						<a href={ Route(ctx, "/tenant/" + t.Name + "/rotate") } class="button secondary">Rotate password</a>
						<a href={ Route(ctx, "/tenant/" + t.Name + "/restore") } class="button secondary">Restore from backup</a>
					}
				</div>
				if !hasManagedRole(t) {
					<p class="muted"><small>Lifecycle and password actions remain with the external application because this database is owned by the shared role <code>{ t.Owner }</code>.</small></p>
				}
			</article>
			if hasManagedRole(t) {
				<article class="danger-zone">
					<header><h2>Danger zone</h2></header>
					<p class="muted">Dropping a tenant permanently removes its database from <strong>{ CurrentPage(ctx).DisplayName }</strong>.</p>
					<a href={ Route(ctx, "/tenant/" + t.Name + "/drop") } class="button danger">Drop tenant</a>
				</article>
			}
		}
		<article>
			<header><h2>CLI</h2></header>
			<pre><code>cnpgctl --cluster { CurrentPage(ctx).ClusterID } psql { t.Name }
cnpgctl --cluster { CurrentPage(ctx).ClusterID } backup { t.Name }
cnpgctl --cluster { CurrentPage(ctx).ClusterID } dump { t.Name } -o { t.Name }.dump
cnpgctl --cluster { CurrentPage(ctx).ClusterID } branch { t.Name } { tenant.DefaultBranchDestination(t.Name) }</code></pre>
			<small>Equivalent CLI commands are kept for automation and recovery.</small>
		</article>
	}
}

// connectionStrings renders the six F1 formats (URL/Prisma/libpq/JDBC/env/psql). When creds
// is nil (missing Secret, missing RBAC, ESO mid-sync), shows a degraded
// notice that points to the runbook instead of a stack-trace 500.
templ connectionStrings(creds *tenant.Credentials) {
	<article>
		<header><h2>Connection strings</h2></header>
		if creds == nil {
			<p>
				<small>
					Credentials Secret not readable. Either the tenant's
					<code>*-pg-credentials</code> Secret is missing in the cluster,
					or the cnpg-portal pod is missing <code>secrets:get</code> RBAC
					on the <code>pg</code> namespace. 
				</small>
			</p>
		} else {
			@hostKV(creds)
			for _, f := range connstr.All {
				@formatBlock(f, creds.Inputs())
			}
		}
	</article>
}

// hostKV is a small read-only summary of the connection coordinates so the
// user sees host/port/db/user separately, not just buried in URLs.
templ hostKV(c *tenant.Credentials) {
	@kv("host", c.Host)
	@kv("port", fmt.Sprintf("%d", c.Port))
	@kv("database", c.Database)
	@kv("user", c.User)
}

// formatBlock renders one connection-string format with a copy button.
// The copy uses navigator.clipboard.writeText via a vanilla onclick — we
// don't pull in Alpine.js for one button.
templ formatBlock(f connstr.Format, in connstr.Inputs) {
	<details>
		<summary><strong>{ f.Label }</strong> <small class="muted">{ f.Description }</small></summary>
		<div class="copy-field">
			<pre><code>{ f.Render(in) }</code></pre>
			<button
				type="button"
				class="secondary"
				data-copy
			>Copy</button>
		</div>
	</details>
}

// kv renders a single label/value row using semantic <dl> grouping inside
// the <article> body.
templ kv(k, v string) {
	<dt>{ k }</dt>
	<dd><code>{ v }</code></dd>
}

// TenantNotFound renders when /tenant/<bad-name> is requested. Distinct
// from a generic 500 because we want users following stale bookmarks to
// see a route back to the list, not a stack trace.
templ TenantNotFound(name string) {
	@Layout("cnpg-portal — not found") {
		<article>
			<header>tenant <code>{ name }</code> not found</header>
			<p>No database with that name exists in the CNPG cluster.</p>
			<p><a href={ Route(ctx, "/") }>← back to tenant list</a></p>
		</article>
	}
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func connLimitStr(n int) string {
	if n < 0 {
		return "unlimited"
	}
	return fmt.Sprintf("%d", n)
}

// hasManagedRole reports whether the database has a dedicated login role
// that PGM can rotate / re-secret. Postgres-owned databases (CNPG bootstrap
// defaults, raw migrated DBs) fail this check, so the UI hides actions
// that would only fail at the cluster level.
func hasManagedRole(t *tenant.Tenant) bool {
	return t.Owner == t.Name && t.Login
}
