package templates

import (
	"fmt"
	"time"

	"github.com/aberti/cnpg-portal/internal/cnpg"
)

// BackupStatus is the htmx-swapped result fragment for the top-level
// Backup button. Render states:
//   - canTrigger=false       -> muted "admin required" message (no button)
//   - ready=true             -> green "Trigger backup" button
//   - err != ""              -> red message + "Retry" button
//   - b != nil && err == ""  -> success message + "Backup again" button
//
// The button itself fires hx-post="/backup" with hx-disabled-elt so the
// user can't double-click during the ~30–90s wait. CNPG backups are
// cluster-wide, not per-tenant, so this lives in the page header.
templ BackupStatus(ready bool, b *cnpg.Backup, err string, canTrigger bool) {
	<div id="backup-status" aria-live="polite">
		if !canTrigger {
			<small class="muted">Backup is admin-only.</small>
		} else if ready {
			<form method="post" action={ Route(ctx, "/backup") }>
				<button class="secondary" type="submit">Trigger backup</button>
			</form>
		} else if err != "" {
			<span class="alert" role="alert">Backup failed: { err }</span>
			<form method="post" action={ Route(ctx, "/backup") }>
				<button class="secondary" type="submit">Retry</button>
			</form>
		} else if b != nil {
			<small>
				✓ { b.Name } — completed { describeBackup(b) }
			</small>
			<form method="post" action={ Route(ctx, "/backup") }>
				<button class="secondary" type="submit">Backup again</button>
			</form>
		}
	</div>
}

func describeBackup(b *cnpg.Backup) string {
	if b == nil || b.StoppedAt.IsZero() || b.StartedAt.IsZero() {
		return ""
	}
	return fmt.Sprintf("in %s", b.StoppedAt.Sub(b.StartedAt).Round(time.Second))
}
