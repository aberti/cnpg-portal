package templates

// RestoreBackupChoice is a completed backup option for the restore form.
type RestoreBackupChoice struct {
	Name string
	When string
}

templ RestoreTenantForm(app string, backups []RestoreBackupChoice, errMsg string) {
	@Layout("cnpg-portal — restore from backup") {
		<nav aria-label="breadcrumb">
			<ul>
				<li><a href={ Route(ctx, "/") }>Tenants</a></li>
				<li><a href={ Route(ctx, "/tenant/" + app) }>{ app }</a></li>
				<li>Restore</li>
			</ul>
		</nav>
		<article>
			<header>Restore <code>{ app }</code> from backup</header>
			<p><small>
				Provisions a temporary recovery cluster from the selected CNPG backup, then replaces this tenant&rsquo;s database on the primary via pg_dump&nbsp;|&nbsp;pg_restore.
				The tenant role and Kubernetes Secret are unchanged. This destroys current database contents for <code>{ app }</code>.
			</small></p>
			<p><small>Requires RBAC to create/delete CNPG Cluster CRs in the same namespace as <code>pg-primary</code>.</small></p>
			if errMsg != "" {
				<p><small style="color:var(--pico-color-red-600);">{ errMsg }</small></p>
			}
			if len(backups) == 0 {
				<p><small>No completed backups found for this cluster. Trigger a backup first.</small></p>
			} else {
				<form method="post" action={ Route(ctx, "/tenant/" + app + "/restore") }>
					<label>
						Backup
						<select name="backup" required>
							for _, b := range backups {
								<option value={ b.Name }>{ b.Name } — { b.When }</option>
							}
						</select>
					</label>
					<label>
						PITR target time (optional, RFC3339 UTC)
						<input name="target_time" type="text" placeholder="2006-01-02T15:04:05Z" autocomplete="off"/>
					</label>
					<label>
						Type tenant name to confirm
						<input name="confirm" type="text" required placeholder={ app } autocomplete="off"/>
					</label>
					<button type="submit" class="secondary">Restore now</button>
				</form>
			}
			<p><a href={ Route(ctx, "/tenant/" + app) }>← Back to tenant</a></p>
		</article>
	}
}

templ RestoreTenantDone(app string) {
	@Layout("cnpg-portal — restore complete") {
		<article>
			<header>Restore complete</header>
			<p><small>Database <code>{ app }</code> on the primary was replaced from the recovery stream.</small></p>
			<p><a href={ Route(ctx, "/tenant/" + app) }>Back to tenant</a></p>
		</article>
	}
}
