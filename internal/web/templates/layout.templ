package templates

import "github.com/aberti/cnpg-portal/internal/version"

// Layout is the page chrome shared by every UI route. Pico.css gives us a
// reasonable visual baseline with zero build step; htmx gives us
// progressive enhancement for the action buttons in Slice 2.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<style>
				main.container { max-width: 95rem; }
				header.container > nav { padding-bottom: 0.5rem; }
				footer.container { color: var(--pico-muted-color); font-size: 0.85rem; padding: 1rem 0; }
				code { padding: 0.05rem 0.3rem; }
			</style>
		</head>
		<body hx-ext="">
			<header class="container">
				<hgroup>
					<h1>cnpg-portal</h1>
					<p>Self-service DB platform on CloudNativePG</p>
				</hgroup>
				<nav>
					<ul>
						<li><a href="/" hx-boost="true">Tenants</a></li>
					</ul>
				</nav>
			</header>
			<main class="container">
				{ children... }
			</main>
			<footer class="container">
				<small>cnpg-portal { version.Version } &middot; commit { version.Commit }</small>
			</footer>
		</body>
	</html>
}

// ErrorPage renders a generic error frame for handler failures.
templ ErrorPage(title, body string) {
	@Layout(title) {
		<article>
			<header>{ title }</header>
			<p>{ body }</p>
		</article>
	}
}
