package templates

import "github.com/aberti/cnpg-portal/internal/version"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			<header class="app-bar">
				<div class="app-bar__inner">
					<a class="brand" href={ Route(ctx, "/") }>
						<span class="brand__mark" aria-hidden="true">PG</span>
						<span>CNPG Portal</span>
					</a>
					<span class="app-bar__spacer"></span>
					if len(CurrentPage(ctx).Clusters) > 0 {
						<div class="cluster-switch">
							<label for="cluster-switcher">Cluster</label>
							<select id="cluster-switcher" data-cluster-switcher aria-label="Active CNPG cluster">
								for _, cluster := range CurrentPage(ctx).Clusters {
									<option value={ cluster.URL } selected?={ cluster.Active }>
										{ cluster.DisplayName } — { cluster.Namespace } / { cluster.ClusterName }
									</option>
								}
							</select>
						</div>
					}
					if CurrentPage(ctx).Login != "" {
						<div class="identity">
							<strong>{ CurrentPage(ctx).Login }</strong>
							if CurrentPage(ctx).IsAdmin {
								<span class="badge">Admin</span>
							} else {
								<span class="badge viewer">Viewer</span>
							}
						</div>
					}
				</div>
			</header>
			<main id="main" class="shell">
				{ children... }
			</main>
			<footer>
				<small>cnpg-portal { version.Version } &middot; commit { version.Commit }</small>
			</footer>
		</body>
	</html>
}

// ErrorPage renders a generic error frame for handler failures.
templ ErrorPage(title, body string) {
	@Layout(title) {
		<article class="form-card">
			<header><h2>{ title }</h2></header>
			<p class="alert" role="alert">{ body }</p>
		</article>
	}
}
